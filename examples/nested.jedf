{"type":"document","version":1,"blocks":[{"type":"heading","level":1,"content":[{"text":"Nested structures"}]},{"type":"section","title":[{"text":"Outer section"}],"blocks":[{"type":"paragraph","content":[{"text":"Sections nest. This section holds another section, a table with a rich cell, and a footnote with more than one block."}]},{"type":"section","title":[{"text":"Inner section"}],"blocks":[{"type":"paragraph","content":[{"text":"List items are lists of blocks, so an item can hold a sub-list:"}]},{"type":"list","ordered":false,"items":[[{"type":"paragraph","content":[{"text":"Item with a sub-list"}]},{"type":"list","ordered":true,"items":[[{"type":"paragraph","content":[{"text":"First sub-item"}]}],[{"type":"paragraph","content":[{"text":"Second sub-item, with a "},{"text":"link","marks":{"link":"https://example.com"}}]}]]}],[{"type":"paragraph","content":[{"text":"Item with two paragraphs."}]},{"type":"paragraph","content":[{"text":"This is the second one."}]}]]},{"type":"section","title":[{"text":"Innermost section"}],"blocks":[{"type":"paragraph","content":[{"text":"Three levels of sections deep."}]}]}]},{"type":"table","rows":[{"header":true,"cells":[[{"type":"paragraph","content":[{"text":"Cell"}]}],[{"type":"paragraph","content":[{"text":"Contents"}]}]]},{"header":false,"cells":[[{"type":"paragraph","content":[{"text":"A plain cell"}]}],[{"type":"paragraph","content":[{"text":"A cell holding a list:"}]},{"type":"list","ordered":false,"items":[[{"type":"paragraph","content":[{"text":"one"}]}],[{"type":"paragraph","content":[{"text":"two"}]}]]}]]}]},{"type":"footnote","id":"deep","blocks":[{"type":"paragraph","content":[{"text":"A footnote whose content is more than a single paragraph."}]},{"type":"list","ordered":false,"items":[[{"type":"paragraph","content":[{"text":"Even a list"}]}]]}]}]},{"type":"heading","level":2,"content":[{"text":"A level-two heading outside any section"}]},{"type":"paragraph","content":[{"text":"End of the nested example."}]}]}
