{"blocks":[{"content":[{"text":"jedf showcase"}],"level":1,"type":"heading"},{"content":[{"text":"A paragraph can mix "},{"marks":{"emphasis":true},"text":"emphasis"},{"text":", "},{"marks":{"strong":true},"text":"strong text"},{"text":", "},{"marks":{"code":true},"text":"inline code"},{"text":", an inline formula "},{"marks":{"math":true},"text":"x^2"},{"text":", and a "},{"marks":{"link":"https://example.com"},"text":"link"},{"text":"."}],"type":"paragraph"},{"blocks":[{"content":[{"text":"Things jedf documents cannot contain:"}],"type":"paragraph"},{"items":[[{"content":[{"text":"macros"}],"type":"paragraph"}],[{"content":[{"text":"scripts"}],"type":"paragraph"}],[{"content":[{"text":"embedded fonts"}],"type":"paragraph"}]],"ordered":false,"type":"list"},{"content":[{"text":"Reading a document is a three-step process:"}],"type":"paragraph"},{"items":[[{"content":[{"text":"parse the standard JSON form"}],"type":"paragraph"}],[{"content":[{"text":"validate the semantic tree"}],"type":"paragraph"}],[{"content":[{"text":"render the tree"}],"type":"paragraph"}]],"ordered":true,"type":"list"},{"rows":[{"cells":[[{"content":[{"text":"Renderer"}],"type":"paragraph"}],[{"content":[{"text":"Output"}],"type":"paragraph"}]],"header":true},{"cells":[[{"content":[{"text":"HTML flow"}],"type":"paragraph"}],[{"content":[{"text":"screen reading"}],"type":"paragraph"}]],"header":false},{"cells":[[{"content":[{"text":"Typst"}],"type":"paragraph"}],[{"content":[{"text":"print layout"}],"type":"paragraph"}]],"header":false}],"type":"table"}],"title":[{"text":"Lists and tables"}],"type":"section"},{"blocks":[{"language":"moonbit","text":"fn main {\n  println(\"hello, jedf\")\n}","type":"code"},{"source":"E = mc^2","type":"math"},{"content":[{"text":"日本語のテキストも、そのまま文字として扱えます。"}],"type":"paragraph"}],"title":[{"text":"Code, math, and other languages"}],"type":"section"},{"alt":"Diagram of a document as a tree of blocks","caption":[{"text":"Figure 1: a document is a tree of blocks."}],"sr